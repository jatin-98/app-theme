<script>
  (function() {
    function initCategoryTabSwiper() {
      var swiperEl = document.querySelector('.tab_section .mySwiper');
      if (!swiperEl || swiperEl.swiper || typeof Swiper === 'undefined') return;
      
      var tabLinks = document.querySelectorAll('.tabs-wraperr .tablinks');
      var categorySwiper = new Swiper(swiperEl, {
        slidesPerView: 1,
        spaceBetween: 0,
        speed: 350,
        on: {
          slideChange: function() {
            var activeIdx = this.activeIndex;
            tabLinks.forEach(function(btn, i) {
              if (i === activeIdx) {
                btn.classList.add('active');
              } else {
                btn.classList.remove('active');
              }
            });
          }
        }
      });

      tabLinks.forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          var slideIdx = parseInt(this.getAttribute('data-slide'), 10);
          tabLinks.forEach(function(b) { b.classList.remove('active'); });
          this.classList.add('active');
          if (categorySwiper && typeof categorySwiper.slideTo === 'function') {
            categorySwiper.slideTo(slideIdx);
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCategoryTabSwiper);
    } else {
      initCategoryTabSwiper();
    }
  })();
</script>


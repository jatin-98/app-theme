<div class="Main__bannerLayoutWp" data-section-type="main-banner">
  <div class="Main__bannnerContainerWp">
    <div class="Main__bannerInteriorWp swiper">
      <div class="Main__bannerWidget swiper-wrapper">
        
        <!-- Slide 1: Omega 3 6X -->
        <div class="Main__bannerCoded swiper-slide">
          <div class="Main__bannerImage">
            <a aria-label="NATURALTEIN Ultimate Omega-3" href="/products/naturaltein-ultimate-omega-3">
              <span class="banner_shopNow_btn">Shop Now</span>
              <picture>
                <source media="(max-width: 749px)" srcset="//naturaltein.in/cdn/shop/files/omega_3_6X_BANNER_PHONE_copy.webp?v=1789112192&width=800">
                <img src="//naturaltein.in/cdn/shop/files/omega_3_6X_BANNER_WEB_1.webp?quality=80&v=1789110017&width=2000" alt="Omega 3 6X" class="Main__bannerImg" loading="eager">
              </picture>
            </a>
          </div>
        </div>

        <!-- Slide 2: Yes Protein Aamras -->
        <div class="Main__bannerCoded swiper-slide">
          <div class="Main__bannerImage">
            <a aria-label="Yes Protein Aamras" href="/products/100-natural-yes-protein">
              <span class="banner_shopNow_btn">Shop Now</span>
              <picture>
                <source media="(max-width: 749px)" srcset="//naturaltein.in/cdn/shop/files/yes_protein_aamras_banner_MOBILE.webp?v=1786274841&width=800">
                <img src="//naturaltein.in/cdn/shop/files/yes_protein_aamras_banner_web.webp?quality=80&v=1786274821&width=2000" alt="Yes Protein Aamras" class="Main__bannerImg" loading="lazy">
              </picture>
            </a>
          </div>
        </div>

        <!-- Slide 3: Creamag 3 New Flavours -->
        <div class="Main__bannerCoded swiper-slide">
          <div class="Main__bannerImage">
            <a aria-label="Creamag Boost Flavours" href="/products/creamag-boost">
              <span class="banner_shopNow_btn">Shop Now</span>
              <picture>
                <source media="(max-width: 749px)" srcset="//naturaltein.in/cdn/shop/files/3_new_flavour_Creamag_Banner_Mobile.webp?v=1784696064&width=800">
                <img src="//naturaltein.in/cdn/shop/files/3_new_flavour_Creamag_Banner.webp?quality=80&v=1784696053&width=2000" alt="Creamag 3 Flavours" class="Main__bannerImg" loading="lazy">
              </picture>
            </a>
          </div>
        </div>

        <!-- Slide 4: Anytime Fitness Collab -->
        <div class="Main__bannerCoded swiper-slide">
          <div class="Main__bannerImage">
            <a aria-label="Anytime Fitness Collaboration" href="/collections/all">
              <span class="banner_shopNow_btn">Shop Now</span>
              <picture>
                <source media="(max-width: 749px)" srcset="//naturaltein.in/cdn/shop/files/Anytime_Fitness_Collab_Banner_Mobile_1.webp?v=1784714753&width=800">
                <img src="//naturaltein.in/cdn/shop/files/Anytime_Fitness_Collab_Banner_1.webp?quality=80&v=1784714737&width=2000" alt="Anytime Fitness Collab" class="Main__bannerImg" loading="lazy">
              </picture>
            </a>
          </div>
        </div>

        <!-- Slide 5: Milind Soman Isoboost -->
        <div class="Main__bannerCoded swiper-slide">
          <div class="Main__bannerImage">
            <a aria-label="Milind Soman Isoboost" href="/products/whey-protein-iso-boost">
              <span class="banner_shopNow_btn">Shop Now</span>
              <picture>
                <source media="(max-width: 749px)" srcset="//naturaltein.in/cdn/shop/files/milind_soman_isoboost_banner_mobile_1_a46ff414-2903-40e8-bc4a-193f49e26db8.webp?v=1755156703&width=800">
                <img src="//naturaltein.in/cdn/shop/files/milind_soman_isoboost_banner_1_1.webp?quality=80&v=1755156686&width=2000" alt="Milind Soman Isoboost" class="Main__bannerImg" loading="lazy">
              </picture>
            </a>
          </div>
        </div>

        <!-- Slide 6: Max Flavour Protein -->
        <div class="Main__bannerCoded swiper-slide">
          <div class="Main__bannerImage">
            <a aria-label="Max Flavour Protein" href="/collections/whey-protein-max">
              <span class="banner_shopNow_btn">Shop Now</span>
              <picture>
                <source media="(max-width: 749px)" srcset="//naturaltein.in/cdn/shop/files/max_flavour_final_BANNER_mob_1_copy_f6ab14fa-a0c6-4bb3-88ed-879b1fbff0eb.webp?v=1754478406&width=800">
                <img src="//naturaltein.in/cdn/shop/files/max_flavour_final_BANNER_PC_copy_2.webp?quality=80&v=1750234720&width=2000" alt="Max Flavour Protein" class="Main__bannerImg" loading="lazy">
              </picture>
            </a>
          </div>
        </div>

      </div>

      <div class="swiper-pagination"></div>
      <div class="swiper-button-next"></div>
      <div class="swiper-button-prev"></div>
    </div>
  </div>
</div>


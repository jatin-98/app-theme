          <li><a href="/collections/omega-3">Ultimate Omega-3 6X</a></li>
          <li><a href="/collections/gummies">Biotin & Sleep Gummies</a></li>
        </ul>
      </div>

      <!-- Column 3: About Us -->
      <div class="footer-block">
        <h3 class="accordion-toggle">About Us</h3>
        <ul class="footer-block__details-content" style="list-style:none; padding:0; margin:0;">
          <li><a href="/pages/contact">About Naturaltein</a></li>
          <li><a href="/pages/our-certifications">German Engineered Nutrition</a></li>
          <li><a href="/pages/cologne-list">Zero Banned Substances</a></li>
          <li><a href="/pages/our-certifications">Stevia Sweetened Formulation</a></li>
          <li><a href="/pages/contact">Partner With Us</a></li>
        </ul>
      </div>

      <!-- Column 4: More / Policies -->
      <div class="footer-block">
        <h3 class="accordion-toggle">Customer Support</h3>
        <ul class="footer-block__details-content" style="list-style:none; padding:0; margin:0;">
          <li><a href="/pages/contact">Contact Us</a></li>
          <li><a href="/pages/shipping">Shipping & Delivery Policy</a></li>
          <li><a href="/pages/cancellation-and-refund">Cancellation & Refund</a></li>
          <li><a href="/pages/privacy-policy">Privacy Policy</a></li>
          <li><a href="/pages/terms-and-condition">Terms and Conditions</a></li>
        </ul>
      </div>

      <!-- Column 5: Shipment Query -->
      <div class="footer-block">
        <h3 class="accordion-toggle">Shipment Query</h3>
        <div class="footer-block__details-content" style="font-size:13px; line-height:1.8;">
          <p style="margin:0 0 8px;"><strong>Phone / WhatsApp:</strong><br><a href="tel:+918071423789">+91 8071423789</a></p>
          <p style="margin:0 0 8px;"><strong>Email:</strong><br><a href="mailto:info@naturaltein.in">info@naturaltein.in</a></p>
          <p style="margin:0;"><strong>Hours:</strong><br>Mon - Sat (10:00 AM - 5:00 PM)</p>
        </div>
      </div>

      <!-- Column 6: Connect & Newsletter -->
      <div class="footer-block">
        <h3 class="accordion-toggle">Stay Connected</h3>
        <div class="footer-block__details-content">
          <p style="font-size:12px; margin-bottom:12px; opacity:0.9;">Sign up for exclusive offers and clean fitness nutrition tips.</p>
          <form method="post" action="/contact#contact_form" class="footer-newsletter-box">
            <input type="hidden" name="form_type" value="customer">
            <input type="hidden" name="utf8" value="✓">
            <input type="email" name="contact[email]" placeholder="Enter your email" required>
            <button type="submit">Subscribe</button>
          </form>
          <div class="footer-social-icons" style="display:flex; gap:12px; margin-top:16px;">
            <a href="https://www.instagram.com/naturaltein" target="_blank" rel="noopener" aria-label="Instagram" style="display:inline-flex; width:32px; height:32px; background:rgba(255,255,255,0.2); border-radius:50%; align-items:center; justify-content:center;">
              <i class="fa fa-instagram"></i>
            </a>
            <a href="https://www.facebook.com/naturaltein" target="_blank" rel="noopener" aria-label="Facebook" style="display:inline-flex; width:32px; height:32px; background:rgba(255,255,255,0.2); border-radius:50%; align-items:center; justify-content:center;">
              <i class="fa fa-facebook"></i>
            </a>
            <a href="https://www.youtube.com/naturaltein" target="_blank" rel="noopener" aria-label="YouTube" style="display:inline-flex; width:32px; height:32px; background:rgba(255,255,255,0.2); border-radius:50%; align-items:center; justify-content:center;">
              <i class="fa fa-youtube-play"></i>
            </a>
            <a href="https://twitter.com/naturaltein" target="_blank" rel="noopener" aria-label="Twitter" style="display:inline-flex; width:32px; height:32px; background:rgba(255,255,255,0.2); border-radius:50%; align-items:center; justify-content:center;">
              <i class="fa fa-twitter"></i>
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom copyright & payment -->
    <div class="footer__content-bottom" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px;">
      <p style="margin:0;">&copy; {{ 'now' | date: '%Y' }} NATURALTEIN INDIA. All Rights Reserved. Formulated with European Craftsmanship.</p>
      <div class="footer-payment-methods" style="display:flex; gap:8px; align-items:center; font-size:22px;">
        <span title="Visa"><i class="fa fa-cc-visa"></i></span>
        <span title="Mastercard"><i class="fa fa-cc-mastercard"></i></span>
        <span title="UPI / Net Banking" style="font-size:12px; font-weight:800; background:rgba(0,0,0,0.3); padding:4px 8px; border-radius:4px;">UPI / COD</span>
      </div>
    </div>
  </div>
</footer>


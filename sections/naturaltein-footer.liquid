          <li><a href="/pages/cologne-list">Cologne List®</a></li>
          <li><a href="/pages/glyphosate">Glyphosate Residue Free</a></li>
          <li><a href="/pages/great-place-to-work-certified">Great Place To Work Certified</a></li>
          <li><a href="/pages/our-certifications">100% Authenticity Guaranteed</a></li>
          <li><a href="/blogs/news">Fitness & Nutrition Blogs</a></li>
        </ul>
      </div>

      <!-- Column 2: Our Products -->
      <div class="footer-block">
        <h3 class="accordion-toggle">Our Products</h3>
        <ul class="footer-block__details-content" style="list-style:none; padding:0; margin:0;">
          <li><a href="/collections/whey-protein">Natural Whey Protein</a></li>
          <li><a href="/collections/natural-yes-protein">100% Natural YES Protein</a></li>
          <li><a href="/collections/plant-protein">Natural Plant Protein</a></li>

        "tab_nutrition": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Nutritional Information & Supplement Facts",
            "content": "<p>Formulated with high biological value whey protein, rich in naturally occurring BCAAs, EAAs, and glutamine. Zero added sugar, zero maltodextrin, and sweetened exclusively with natural stevia.</p>",
            "icon": "heart"
          }
        },
        "tab_ingredients": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "100% Natural Ingredients & Sourcing",
            "content": "<p>Contains pure whey protein derived from open-pasture grass-fed European cows. Free from artificial flavours, chemical sweeteners (aspartame, sucralose, acesulfame K), and banned substances.</p>",
            "icon": "leaf"
          }
        },
        "tab_usage": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "How To Consume & Recommended Dosage",
            "content": "<p>Add 1 scoop (30g) to 200-250ml of cold water or skimmed milk. Shake vigorously in a shaker for 20-30 seconds until completely dissolved. Consume immediately post-workout or in the morning.</p>",
            "icon": "bottle"
          }
        },
        "tab_lab": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Cologne List® & 3rd Party Lab Reports",
            "content": "<p>Every batch of NATURALTEIN is tested and certified by Cologne List® (Germany) and Trustified for banned substances, heavy metals, and protein label accuracy. Scan the QR code on the box to view batch test results.</p>",
            "icon": "check_mark"
          }
        },
        "share": {
          "type": "share",
          "disabled": true,
          "settings": {
